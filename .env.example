# rmu-api-media: local development outside Docker (`pnpm start:dev`). Copy to .env.
# Requires the infrastructure started from rmu-platform (`make up-infra`). From the host:
# Mongo localhost:27017 and Keycloak http://localhost:8090/sso. media uses no Kafka (spec 021).

# --- Server ---------------------------------------------------------------------------------------
PORT=3011
LOG_LEVEL=debug

# --- MongoDB --------------------------------------------------------------------------------------
RMU_MONGO_MEDIA_URI=mongodb://admin:admin@localhost:27017/rmu-media?authSource=admin

# --- Keycloak -------------------------------------------------------------------------------------
RMU_IAM_JWK_URI=http://localhost:8090/sso/realms/rmu/protocol/openid-connect/certs
RMU_IAM_ISSUER_URI=http://localhost/sso/realms/rmu
RMU_IAM_AUDIENCE=rmu-api

# --- Media: S3 storage ----------------------------------------------------------------------------
RMU_MEDIA_S3_REGION=eu-west-1
RMU_MEDIA_S3_BUCKET=rmu-static-assets-pro
RMU_MEDIA_S3_BASE_FOLDER=rmu-mfe-assets
RMU_MEDIA_S3_IMAGE_FOLDER=images
RMU_MEDIA_S3_ACCESS_KEY_ID=aws-key-id
RMU_MEDIA_S3_SECRET_ACCESS_KEY=aws-secret-access-key
# Custom endpoint for S3-compatible storage (MinIO, LocalStack). Unset for AWS.
# RMU_MEDIA_S3_ENDPOINT=http://localhost:9000
RMU_MEDIA_S3_FORCE_PATH_STYLE=true

# --- Media: image processing ----------------------------------------------------------------------
RMU_MEDIA_IMAGE_MAX_WIDTH=2048
# RMU_MEDIA_IMAGE_IMPORT_PARALLELISM=4
# RMU_MEDIA_IMAGE_IMPORT_BATCH_SIZE=50

# --- HTTP (optional) --------------------------------------------------------------------------------
# No origins: CORS stays off. RMU_THROTTLE_LIMIT=0 turns the request limit off.
RMU_CORS_ORIGINS=
RMU_THROTTLE_LIMIT=300
RMU_THROTTLE_TTL_MS=60000
RMU_TRUST_PROXY=loopback, linklocal, uniquelocal
