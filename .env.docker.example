# rmu-api-media: container on the rmu-platform Docker network (`make docker-run`). Copy to .env.docker.
# Requires the infrastructure started from rmu-platform (network rmu-network), so the hosts are the
# container names. In the full Compose stack (profile apis) rmu-platform/compose/apis.yaml injects
# these values and this file is not used.

# --- Server ---------------------------------------------------------------------------------------
PORT=3011
LOG_LEVEL=debug

# --- MongoDB --------------------------------------------------------------------------------------
RMU_MONGO_MEDIA_URI=mongodb://admin:admin@rmu-mongo:27017/rmu-media?authSource=admin

# --- Keycloak -------------------------------------------------------------------------------------
RMU_IAM_JWK_URI=http://rmu-keycloak:8080/sso/realms/rmu/protocol/openid-connect/certs
RMU_IAM_ISSUER_URI=http://localhost/sso/realms/rmu
RMU_IAM_AUDIENCE=rmu-api

# --- Media: S3 storage ----------------------------------------------------------------------------
RMU_MEDIA_S3_REGION=eu-west-1
RMU_MEDIA_S3_BUCKET=rmu-static-assets-pro
# Uploads go to <prefix>/<category>/<id>.<ext> (spec 057); never under the files of rmu-mfe-assets.
RMU_MEDIA_S3_UPLOADS_PREFIX=uploads
RMU_MEDIA_S3_ACCESS_KEY_ID=aws-key-id
RMU_MEDIA_S3_SECRET_ACCESS_KEY=aws-secret-access-key
# Custom endpoint for S3-compatible storage (MinIO, LocalStack). Unset for AWS.
# RMU_MEDIA_S3_ENDPOINT=http://<s3-compatible-host>:9000
RMU_MEDIA_S3_FORCE_PATH_STYLE=true

# --- Media: image processing ----------------------------------------------------------------------
RMU_MEDIA_IMAGE_MAX_WIDTH=2048
# Largest upload in bytes (10 MB); a larger file is a 413.
RMU_MEDIA_UPLOAD_MAX_BYTES=10485760

# --- Media: base images (manifest of rmu-mfe-assets, spec 057) ---------------------------------
RMU_MEDIA_BASE_MANIFEST_URI=http://rmu-mfe-assets/images/manifest.json
RMU_MEDIA_BASE_MANIFEST_TTL_MS=60000

# --- HTTP (optional) --------------------------------------------------------------------------------
# No origins: CORS stays off. RMU_THROTTLE_LIMIT=0 turns the request limit off.
RMU_CORS_ORIGINS=
RMU_THROTTLE_LIMIT=300
RMU_THROTTLE_TTL_MS=60000
RMU_TRUST_PROXY=loopback, linklocal, uniquelocal
